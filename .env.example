# Modèle de configuration. Fichier VERSIONNÉ : n'y mettre aucun secret.
# Copier vers `.env.local` (ignoré par git) et y renseigner les vraies valeurs.

# ─────────────────────────────── Site ───────────────────────────────
# URL publique, utilisée pour les canonicals, le sitemap et l'OpenGraph.
NEXT_PUBLIC_SITE_URL=https://autourdemoi.site

# ───────────────────────────── LocalShark ───────────────────────────
# Renseigner DIRECTORY_API_KEY active le mode API : toutes les données du
# site proviennent alors de l'annuaire LocalShark.
# Laissée vide, le site fonctionne sur les données de démonstration `data/`.
#
# ⚠️ Secret de build : jamais de préfixe NEXT_PUBLIC_, la clé ne doit pas
# être exposée au navigateur.
DIRECTORY_API_KEY=

# URL de base de l'API. Défaut : https://app.localshark.io
# En développement local, pointer vers l'instance locale — schéma obligatoire.
LOCALSHARK_API_URL=

# Origine du widget d'avis embarqué en iframe.
# Par défaut : LOCALSHARK_API_URL. L'URL renvoyée par l'API dépend de
# SON environnement — elle est systématiquement rebasée ici, seuls le
# chemin et la requête sont conservés.
# À ne renseigner que si le widget n'est pas servi par le même hôte.
LOCALSHARK_WIDGET_URL=

# Affichage du widget d'avis (tous optionnels).
# Valeurs acceptées :
#   VARIANT   grid | list | slider | masonry | badge
#   HEADER    full | minimal | side | none
#   THEME     light | dark
#   SORT      recent | highest | lowest
#   RATINGS   liste de notes, ex. « 4,5 » (défaut : 4,5)
#   WITH_TEXT 0 | 1 — exclut les notes sans commentaire (défaut : 1)
#   LANG      fr | en | es (défaut : fr)
# Laissé vide sans défaut, le paramètre n'est pas imposé : la valeur
# renvoyée par l'API est conservée.
LOCALSHARK_WIDGET_VARIANT=
LOCALSHARK_WIDGET_HEADER=
LOCALSHARK_WIDGET_THEME=
LOCALSHARK_WIDGET_SORT=
LOCALSHARK_WIDGET_RATINGS=4,5
LOCALSHARK_WIDGET_WITH_TEXT=1
LOCALSHARK_WIDGET_LANG=fr

# Durée de cache ISR des réponses API, en secondes (défaut : 3600).
LOCALSHARK_REVALIDATE_SECONDS=3600

# Délai maximal d'une requête, en millisecondes (défaut : 30000).
# L'endpoint global ramène toutes les fiches d'un coup : prévoir large.
LOCALSHARK_TIMEOUT_MS=30000

# Mettre à 1 pour faire échouer le build en cas d'erreur API, ou lorsque
# l'API répond mais que les colonnes ville/catégorie sont vides, au lieu de
# retomber silencieusement sur les données de démonstration.
# Recommandé en pré-production.
LOCALSHARK_STRICT=0
